    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Drag the handle to reorder, or use the reorder menu for keyboard access. Click a name to relabel that zone — Calgary for Edmonton, say — and leave it empty to use the city name. The emoji box is optional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie am Griff, um die Reihenfolge zu ändern, oder verwenden Sie das Verschieben-Menü für die Tastaturbedienung. Klicken Sie auf einen Namen, um die Zone umzubenennen – z. B. Calgary für Edmonton – und lassen Sie das Feld leer, um den Städtenamen zu verwenden. Das Emoji-Feld ist optional."
          }
        }
      }
    },
    "Drag to reorder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ändern der Reihenfolge ziehen"
          }
        }
      }
    },
