            "value": "Zeitzonen hinzufügen"
          }
        }
      }
    },
    "Approve Timezone Buddy in System Settings → General → Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timezone Buddy in Systemeinstellungen → Allgemein → Anmeldeobjekte bestätigen."
