        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits hinzugefügt"
          }
        }
      }
    },
    "%lld of %lld shown in menu bar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld in der Menüleiste angezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld shown in menu bar"
          }
        }
      }
    },
    "12": {},
